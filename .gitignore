# Python
__pycache__/
*.pyc

# Dart / Flutter
.dart_tool/
.packages
build/
# Plain `build/` doesn't catch the build symlink we point at
# /tmp/flutter_build_gameplatform/, nor Finder-created duplicates like
# "build 2/". Match the prefix on anything under apps/flutter_app/.
apps/flutter_app/build*
*.dart.js
*.js.deps
*.js.map
*.info.json
pubspec.lock
doc/api/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
*.ipr
*.iws
.idea/
.DS_Store

# Android
**/android/local.properties
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/gradle/wrapper/gradle-wrapper.jar

# iOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/.symlinks/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig

# Supabase
supabase/.branches
supabase/.temp

# Environment
.env
.env.*
!.env.example

# Melos
.melos_tool/

# Coverage
coverage/

# Golden test diff output (only the canonical goldens/ subdir is committed)
**/goldens/failures/

# Redundant archive of prompts/ — committed in source form
prompts.zip

# Local logs from build/launch scripts
/tmp/flutter-*.log

# FVM Version Cache
.fvm/

# Claude Code agent worktrees (auto-generated, large, never to be committed)
.claude/worktrees/
# Local UI-run screen recordings / logs (not for VCS)
ui-run-artifacts/
