<?xml version="1.0" encoding="utf-8"?>
<!-- Splash background drawn behind the Activity while Flutter initialises.
     Replaced when the Flutter engine renders its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/launch_background"/>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image"/>
    </item>
</layer-list>
