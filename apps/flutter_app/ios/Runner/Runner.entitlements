<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: re-add once Xcode has an Apple ID signed in
	     (Settings → Accounts) so automatic signing can regenerate the
	     provisioning profile with the Associated Domains capability:
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:game-platform-staging.web.app</string>
	</array>
	-->
</dict>
</plist>
